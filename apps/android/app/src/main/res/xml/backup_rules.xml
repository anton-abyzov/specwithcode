<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Pairing credentials, the Connect session and the machine list stay on this device;
     the Keystore keys that decrypt them are never backed up either. -->
<full-backup-content>
    <exclude domain="sharedpref" path="credentials.xml" />
    <exclude domain="sharedpref" path="connect.xml" />
    <exclude domain="file" path="credentials" />
    <exclude domain="file" path="datastore/credentials.preferences_pb" />
    <exclude domain="file" path="machines.json" />
    <exclude domain="database" path="credentials.db" />
</full-backup-content>
