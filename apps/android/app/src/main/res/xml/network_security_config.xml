<?xml version="1.0" encoding="utf-8"?>
<!-- Manual pairing reaches machines on the local network over plain http (for example
     http://192.168.1.9:3773), so cleartext is allowed. Connect links use https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
