# Marketing site build-time settings. Astro reads PUBLIC_* variables when the
# site is built (locally from apps/marketing/.env, on Vercel from the project's
# environment variables). Both are optional.

# Cloudflare Web Analytics site token (Cloudflare dashboard > Analytics & Logs >
# Web Analytics > site > JS snippet). When unset, no analytics beacon is rendered.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Origin that receives anonymous download click events at /v1/site-events.
# Defaults to https://relay.spec-weave.com when unset.
PUBLIC_SITE_EVENTS_ORIGIN=
