# Optional: Studio Connect source builds
# Studio ships with no hosted sign-in configured. Every value below is empty,
# so `cp .env.example .env` builds the same app as a checkout with no `.env`:
# cloud features stay off and direct private pairing keeps working.
# Fill these in only to run Studio Connect against a Clerk instance and relay
# you operate (see docs/operations/connect-setup.md). They are public
# identifiers that get baked into the build, not secrets.
# Do not add server-side secrets to this file.

# Your own Clerk instance. Get these from the Clerk Dashboard under API keys,
# JWT templates, and OAuth applications. connect-setup.md names the JWT
# template `studio-relay`.
STUDIO_CLERK_PUBLISHABLE_KEY=
STUDIO_CLERK_JWT_TEMPLATE=
STUDIO_CLERK_CLI_OAUTH_CLIENT_ID=

# Hosted services stay disabled even with the values above until the gate is
# on: the server reads STUDIO_ENABLE_HOSTED_SERVICES=true at run time and the
# web client reads VITE_STUDIO_ENABLE_HOSTED_SERVICES=true at build time.

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in STUDIO_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# STUDIO_APPLE_TEAM_ID=ABC1234567
# STUDIO_MACOS_PROVISIONING_PROFILE=/absolute/path/to/studio.provisionprofile
# STUDIO_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Your own relay, as an HTTPS origin. There is no hosted relay; `infra/relay`
# deploys write this value into `.env` automatically.
STUDIO_RELAY_URL=

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# There is no default; set it to the web deployment you operate.
# STUDIO_HOSTED_APP_URL=https://app.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# STUDIO_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# STUDIO_MOBILE_OTLP_TRACES_DATASET=your-mobile-traces-dataset
# STUDIO_MOBILE_OTLP_TRACES_TOKEN=xaat-...

# Optional: one-click Google connect (Settings > Google account).
# A Google Cloud OAuth client of type "Desktop app" with the Gmail, Calendar
# and Drive APIs enabled. Google treats an installed app's client secret as
# public, so both values are baked into the server build; PKCE protects the
# sign-in. Leave them empty and people save their own client in Settings.
# Setup steps: docs/operations/google-oauth-client.md
STUDIO_GOOGLE_OAUTH_CLIENT_ID=
STUDIO_GOOGLE_OAUTH_CLIENT_SECRET=
